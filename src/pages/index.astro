---
import BaseLayout from '../layouts/BaseLayout.astro';
import curriculum from '../data/curriculum.json';
import '../styles/landing.css';

const maxWeight = Math.max(...curriculum.domains.map((d) => d.weight));
const exam = curriculum.exam;
---

<BaseLayout title="cAIge — Certified AI Guardrail Engineer">
  <section class="hero">
    <div class="hero-badge">Free and vendor-agnostic</div>
    <h1>Certified AI<br>Guardrail Engineer</h1>
    <p>Training and certification for the engineers who keep AI systems safe and secure in production. They design the controls, build them, prove they work, and can stop the system when it goes wrong.</p>
    <div class="btn-group">
      <a href="/training/overview" class="btn btn-primary">Start Training</a>
      <a href="/labs" class="btn btn-secondary">Open the Labs</a>
    </div>
  </section>

  <hr class="divider">

  <section class="what-is">
    <div class="section-label">The Role</div>
    <div class="section-title">What is a Guardrail Engineer?</div>
    <div class="what-is-grid">
      <div>
        <p>A guardrail engineer makes AI systems hard to misuse and safe to run. They threat-model the system, decide which controls go where, implement them, measure whether they work, and operate them in production.</p>
        <p style="margin-top: 16px;">The program is built around one design test: <strong style="color: var(--color-text);">if the model were fully compromised, what is the worst it could do?</strong> Classifiers make failures rarer. Architecture limits how bad they can get. A guardrail engineer uses both and knows the difference.</p>
      </div>
      <div class="highlight-box">
        <h3>Three Kinds of Risk</h3>
        <ul class="pillar-list">
          <li>
            <span class="pillar-marker"></span>
            <span><strong style="color: var(--color-text);">Safety</strong> &mdash; the model says or does something undesirable with no attacker involved</span>
          </li>
          <li>
            <span class="pillar-marker"></span>
            <span><strong style="color: var(--color-text);">Security</strong> &mdash; an adversary manipulates the system to gain authority or data they should not have</span>
          </li>
          <li>
            <span class="pillar-marker"></span>
            <span><strong style="color: var(--color-text);">Containment</strong> &mdash; whatever the cause, the model is limited, observed, and can always be stopped</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="divider">

  <section>
    <div class="section-label">Curriculum</div>
    <div class="section-title">Seven Domains</div>
    <div class="section-subtitle">From how models behave, through threat modeling, security, safety, and containment, to measuring and operating guardrails in production.</div>
    <div class="domains-grid">
      {curriculum.domains.map((d) => (
        <a class="domain-card" href={`/training/module/${d.slug}`}>
          <div class="domain-weight">{d.weight}%</div>
          <h3>{d.domain}. {d.title}</h3>
          <div class="domain-bar"><div class="domain-bar-fill" style={`width: ${Math.round((d.weight / maxWeight) * 100)}%;`}></div></div>
        </a>
      ))}
    </div>
  </section>

  <hr class="divider">

  <section>
    <div class="section-label">Process</div>
    <div class="section-title">How It Works</div>
    <div class="section-subtitle">Learn the concepts, practice on a real system, then prove it.</div>
    <div class="steps">
      <div class="step">
        <div class="step-number">1</div>
        <h3>Study</h3>
        <p>Seven domains and 43 sections of free training, each tied to real incidents and ending with self-check questions.</p>
      </div>
      <div class="step">
        <div class="step-number">2</div>
        <h3>Build</h3>
        <p>Harden Acme Support, a multi-tenant AI agent with deliberately naive defaults, across seven labs. Measure attack success and false refusals as you go.</p>
      </div>
      <div class="step">
        <div class="step-number">3</div>
        <h3>Certify</h3>
        <p>Associate: a knowledge exam. Professional: a hands-on exam scored against hidden attack and benign suites. Both are in development; the practice exam is available now.</p>
      </div>
    </div>
  </section>

  <hr class="divider">

  <section>
    <div class="section-label">Practice Exam</div>
    <div class="section-title">Test Your Knowledge</div>
    <div class="section-subtitle">A free practice exam on the Associate blueprint, with answer review linked back to the training.</div>
    <div class="exam-grid">
      <div class="exam-item">
        <div class="exam-item-value">{exam.examSize}</div>
        <div class="exam-item-label">Questions drawn from the full pool, weighted by domain</div>
      </div>
      <div class="exam-item">
        <div class="exam-item-value">{exam.timeLimitMinutes} min</div>
        <div class="exam-item-label">Time limit</div>
      </div>
      <div class="exam-item">
        <div class="exam-item-value">{exam.passPercent}%</div>
        <div class="exam-item-label">Passing standard</div>
      </div>
      <div class="exam-item">
        <div class="exam-item-value">3 types</div>
        <div class="exam-item-label">Multiple choice, multiple select, and scenario-based</div>
      </div>
      <div class="exam-item">
        <div class="exam-item-value">Review</div>
        <div class="exam-item-label">Every missed question explained and linked to its section</div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <section class="cta-section">
    <div class="cta-box">
      <h2>Ready to start?</h2>
      <p>Begin with the training overview, or see where you stand with the practice exam.</p>
      <div class="btn-group">
        <a href="/training/overview" class="btn btn-primary">Start Training</a>
        <a href="/practice-exam" class="btn btn-secondary">Take the Practice Exam</a>
      </div>
    </div>
  </section>
</BaseLayout>
