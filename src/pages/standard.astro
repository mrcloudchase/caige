---
import { getEntry, render } from 'astro:content';
import TrainingLayout from '../layouts/TrainingLayout.astro';

const entry = await getEntry('pages', 'standard');
if (!entry) throw new Error('src/content/pages/standard.md is missing');
const { Content } = await render(entry);
---

<TrainingLayout title={entry.data.title} currentPath="/standard">
  <Content />
</TrainingLayout>
