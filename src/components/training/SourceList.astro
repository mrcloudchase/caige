---
interface Props {
  sources: { title: string; url: string }[];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="source-list">
    <h2>Sources</h2>
    <ol>
      {sources.map((s) => (
        <li><a href={s.url} rel="noopener noreferrer">{s.title}</a></li>
      ))}
    </ol>
  </section>
)}
